{
  "name": "everyday-digital",
  "version": "3.0.0",
  "description": "Every Day Digital — Next.js frontend with headless WordPress backend",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tidy": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test",
    "tidy:check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix=override",
    "update": "pnpm update --latest",
    "prepare": "husky",
    "wp:start": "docker-compose up -d",
    "wp:stop": "docker-compose stop",
    "wp:remove": "docker rm db wordpress phpmyadmin wordpress-cli"
  },
  "keywords": [
    "wordpress",
    "nextjs",
    "react",
    "docker",
    "graphQL",
    "headless-cms"
  ],
  "author": "Cactusman07",
  "license": "ISC",
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --check",
      "eslint --max-warnings 0 --no-warn-ignored",
      "vitest related --run"
    ],
    "*.{json,css,md}": [
      "prettier --check"
    ]
  }
}

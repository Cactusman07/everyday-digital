{
  "name": "everyday-digital",
  "version": "3.0.0",
  "private": true,
  "description": "Every Day Digital — Next.js frontend with headless WordPress backend",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint:php": "node scripts/lint-php.mjs",
    "check": "pnpm run lint && pnpm run lint:php && pnpm run typecheck && pnpm run test",
    "tidy": "pnpm run audit:fix && pnpm run audit && pnpm run format && pnpm run check",
    "tidy:check": "pnpm run audit && pnpm run format:check && pnpm run check",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix=override && pnpm install",
    "update": "pnpm update --latest",
    "prepare": "husky",
    "wp:start": "docker compose up -d",
    "wp:stop": "docker compose stop",
    "wp:remove": "docker compose down"
  },
  "keywords": [
    "wordpress",
    "nextjs",
    "react",
    "docker",
    "graphQL",
    "headless-cms"
  ],
  "author": "Cactusman07",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@formspree/react": "^3.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}

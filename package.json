{
  "name": "everyday-digital",
  "version": "2.0.2",
  "description": "A custom theme for Every Day Digital. Based on tutorial by Sam Muir (https://github.com/Cactusman07/wordpress-react-theme-development)",
  "main": "./src/index.js",
  "scripts": {
    "start": "docker-compose up -d && npm run dev && npm run build-css && npm run build-dev",
    "stop": "docker stop db wordpress phpmyadmin wordpress-cli",
    "remove": "docker rm db wordpress phpmyadmin wordpress-cli",
    "build-prod": "webpack --env production && npm run build-css && node scripts/zip-theme.js",
    "build-dev": "webpack --env development --watch",
    "copy-fonts": "node -e \"const {mkdirSync,readdirSync,copyFileSync}=require('fs');mkdirSync('wpTheme/dist/assets',{recursive:true});readdirSync('src/assets').filter(f=>/\\.(ttf|woff2?|eot)$/.test(f)).forEach(f=>copyFileSync('src/assets/'+f,'wpTheme/dist/assets/'+f))\"",
    "build-css": "npm run copy-fonts && npx tailwind -i ./src/index.css -o ./wpTheme/dist/main.css",
    "watch-css": "npm run copy-fonts && npx tailwind -i ./src/index.css -o ./wpTheme/dist/main.css --watch",
    "dev": "start http://localhost:3000/",
    "test": "tsc && jest"
  },
  "keywords": [
    "wordpress",
    "react",
    "docker",
    "theme",
    "wp theme development",
    "graphQL"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "author": "Cactusman07",
  "license": "ISC",
  "dependencies": {
    "@apollo/client": "^3.7.5",
    "@apollo/react-hooks": "^4.0.0",
    "@formspree/react": "^3.0.0",
    "@headlessui/react": "^1.7.7",
    "@heroicons/react": "^2.0.13",
    "apollo3-cache-persist": "^0.14.1",
    "graphql": "^16.6.0",
    "html-react-parser": "^4.2.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-masonry-css": "^1.0.16",
    "react-router-dom": "^6.14.2",
    "react-super-responsive-table": "^5.2.2",
    "swiper": "^12.2.0"
  },
  "overrides": {
    "axios": "^1.9.0",
    "send": "^0.19.0",
    "serve-static": "^1.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@types/node": "^20.3.2",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@typescript-eslint/eslint-plugin": "^5.48.0",
    "autoprefixer": "^10.4.13",
    "babel-jest": "^29.4.1",
    "babel-loader": "^9.1.2",
    "browser-sync-webpack-plugin": "^2.3.0",
    "css-loader": "^6.7.3",
    "css-modules-typescript-loader": "^4.0.1",
    "eslint": "^8.31.0",
    "eslint-config-standard-with-typescript": "^26.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^15.6.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.31.11",
    "file-loader": "^6.2.0",
    "jest": "^29.4.1",
    "postcss": "^8.4.21",
    "sass": "^1.100.0",
    "sass-loader": "^13.2.0",
    "style-loader": "^3.3.1",
    "tailwindcss": "^3.2.4",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  }
}

{
  "name": "everyday-digital",
  "version": "3.0.0",
  "description": "Every Day Digital — Next.js frontend with headless WordPress backend",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "wp:start": "docker-compose up -d",
    "wp:stop": "docker-compose stop",
    "wp:remove": "docker rm db wordpress phpmyadmin wordpress-cli"
  },
  "keywords": [
    "wordpress",
    "nextjs",
    "react",
    "docker",
    "graphQL",
    "headless-cms"
  ],
  "author": "Cactusman07",
  "license": "ISC",
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.1",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "swiper": "^12.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored",
      "vitest related --run"
    ]
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}

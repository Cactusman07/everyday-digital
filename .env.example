# WordPress GraphQL endpoint (headless CMS)
WORDPRESS_GRAPHQL_URL=http://localhost:8181/graphql

# Public site URL — used for canonical tags, sitemap, OG and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for /api/revalidate. Generate with: openssl rand -hex 32
# Set the SAME value as EDD_REVALIDATE_SECRET in WordPress wp-config.php.
REVALIDATE_SECRET=

# Search engine verification (optional — the meta tags are added when set)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---- Social posting (/api/social) — see docs/SOCIAL-AUTOMATION.md ----
# Shared secret. Same value as EDD_SOCIAL_SECRET in wp-config.php.
SOCIAL_WEBHOOK_SECRET=
# Leave unset (test mode: captions only, nothing posted) until you're happy.
# Set to 1 to post for real.
SOCIAL_LIVE=
# Claude writes the captions. Without a key, simple template captions are used.
ANTHROPIC_API_KEY=
SOCIAL_MODEL=claude-sonnet-5-5
# Facebook Page + Instagram (Instagram must be a Business account linked to the Page)
META_GRAPH_VERSION=v23.0
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
# LinkedIn company page
LINKEDIN_ORG_ID=
LINKEDIN_TOKEN=
LINKEDIN_VERSION=202610

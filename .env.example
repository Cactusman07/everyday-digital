# WordPress GraphQL endpoint (headless CMS)
WORDPRESS_GRAPHQL_URL=http://localhost:8181/graphql

# Public site URL — used for canonical tags, sitemap, OG and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for /api/revalidate. Generate with: openssl rand -hex 32
# Set the SAME value as EDD_REVALIDATE_SECRET in WordPress wp-config.php.
REVALIDATE_SECRET=
